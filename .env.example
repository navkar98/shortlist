# Secrets for Shortlist, read from .env next to config.yaml (`python -m shortlist init` fills in the ones you
# choose). .env is in .gitignore. Real environment variables take precedence over this file.

# --- Scoring: only the backend you use ---
# anthropic_api: a key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# openai_api: a key from https://platform.openai.com
OPENAI_API_KEY=
# claude_cli, for scheduled runs: a long-lived token printed by `claude setup-token` (optional)
CLAUDE_CODE_OAUTH_TOKEN=

# --- Notifications: only if `notify` lists telegram ---
# telegram: the bot token from @BotFather, and the chat to send to (README: Notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
